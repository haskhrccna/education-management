# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quran_review?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters (server refuses to start otherwise).
JWT_SECRET=change-this-to-a-256-bit-secret-minimum-32-characters

# Seed passwords (only used by `prisma db seed`; required in production)
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=

# Server
NODE_ENV=development
PORT=4000

# JWT
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Redis (optional — enables queues and caching)
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Email (optional — enables email notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@quran-review.app

# FCM Push Notifications (optional) — service account credentials, not a
# single key file (config/index.ts reads these three individually).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Workers (set to true in production for background jobs)
ENABLE_WORKERS=false

# Client URL (for CORS in production)
CLIENT_URL=

# Public base URL this API is reachable at (used to build the absolute
# og:image URL on the verify page — WhatsApp/Facebook crawlers need an
# absolute URL, not a relative path). Falls back to http://localhost:<PORT>
# outside production.
PUBLIC_API_URL=

# Mushaf page images (optional — defaults to packages/server/mushaf-pages;
# see scripts/extract_mushaf_pages.py). Set ALLOW_MISSING_MUSHAF_PAGES=1 to
# boot without them (mushaf endpoints degrade instead of failing startup).
MUSHAF_PAGES_DIR=
ALLOW_MISSING_MUSHAF_PAGES=
