# ============================================================================
# Production environment — deploy/docker-compose.prod.yml
#
#   cp deploy/.env.example deploy/.env   and set EVERY value.
#   ./deploy/scripts/check-env.sh deploy/.env   refuses the known defaults.
#
# This file is committed with placeholders ONLY. Real values never enter git
# (gitleaks runs in CI over the full history; .env is docker-ignored).
# ============================================================================

# ── Public identity ─────────────────────────────────────────────────────────
# The bare domain. DNS: api.<DOMAIN> AND media.<DOMAIN> must both be A records
# to this VM's public IP before `up` (Caddy issues a certificate for each).
DOMAIN=example.com
# Optional ACME account email for certificate notices (may stay empty).
ACME_EMAIL=
# The API's absolute public origin (no trailing slash). Used for share images
# and og:image URLs; REQUIRED in production — the server refuses to boot
# without it. Must match mobile/eas.json production EXPO_PUBLIC_API_URL minus
# the /api/v1 suffix.
PUBLIC_API_URL=https://api.example.com
# Origin of the web export (GitHub Pages) — the server's CORS allowlist.
CLIENT_URL=https://haskhrccna.github.io

# ── Container image ─────────────────────────────────────────────────────────
# GHCR image tag deployed by .github/workflows/docker.yml. Pin a commit SHA
# tag for controlled rollbacks; :latest follows main.
API_IMAGE_TAG=latest
# Caddyfile to mount — deploy/Caddyfile for production,
# deploy/Caddyfile.local for LAN verification (internal CA).
CADDY_FILE=Caddyfile

# ── Secrets (generate fresh; check-env.sh refuses the known defaults) ───────
# 256-bit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_64_char_hex_string
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

POSTGRES_USER=quran_review
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=quran_review

# Redis: requirepass (internal network only, but still authenticated).
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# MinIO (S3-compatible media store on this VM). The API refuses the
# well-known 'minioadmin' pair in production.
STORAGE_ACCESS_KEY=CHANGE_ME_minio_access_key
STORAGE_SECRET_KEY=CHANGE_ME_minio_secret_key
STORAGE_BUCKET=quran-review-media
# Public origin that presigned upload URLs are signed for. Defaults to
# https://media.<DOMAIN> (the Caddy media host); set it only if storage is
# published somewhere else.
# STORAGE_PRESIGN_ENDPOINT_URL=https://media.example.com
# Optional CDN/base URL for public share previews (og:image).
STORAGE_PUBLIC_BASE_URL=
# MinIO stopped publishing images; the compose file defaults to a pinned
# community build of the last release. Override to use another build.
# MINIO_IMAGE=ghcr.io/coollabsio/minio:RELEASE.2025-10-15T17-29-55Z

# ── Workers ──────────────────────────────────────────────────────────────────
# BullMQ workers (digests, broadcasts) run in the API process when true.
# Keep true for a single-node deployment.
ENABLE_WORKERS=true

# ── SMTP (required in production: password reset + admin approvals) ────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@example.com
EMAIL_PASS=CHANGE_ME_smtp_app_password
EMAIL_FROM="مراجعة القرآن <noreply@example.com>"

# ── Push (optional until the store build) ────────────────────────────────────
# FCM v1 service-account credentials for Firebase Admin (raw FCM path).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Multi-line private key; when set in .env, keep the literal \n escapes.
FIREBASE_PRIVATE_KEY=
# Expo push service token — only if the Expo project has "enhanced push
# security" enabled.
EXPO_ACCESS_TOKEN=

# ── Mushaf pages ─────────────────────────────────────────────────────────────
# The 604 page images are NOT in git. Either populate the mushaf_pages volume
# (see deploy/README.md) or boot consciously without the reader:
ALLOW_MISSING_MUSHAF_PAGES=1

# ── Off-host backups (REQUIRED — MinIO on this VM is not a backup) ──────────
# Any S3-compatible endpoint: Backblaze B2, Cloudflare R2, AWS S3, another
# MinIO on a different machine. nightly pg_dump + bucket mirror land here.
BACKUP_S3_ENDPOINT=s3.example-backup-host.com
BACKUP_S3_ACCESS_KEY=CHANGE_ME_backup_access_key
BACKUP_S3_SECRET_KEY=CHANGE_ME_backup_secret_key
BACKUP_S3_BUCKET=quran-review-backups
BACKUP_S3_PREFIX=quran-review
BACKUP_S3_USE_SSL=true
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RUN_ON_START=true
# Retention: keep RETAIN_DAILY daily dumps and RETAIN_WEEKLY weekly ones.
RETAIN_DAILY=7
RETAIN_WEEKLY=4

# ── WebRTC TURN (optional; baked into mobile builds, not the server) ────────
# Only relevant when building mobile with a TURN relay for Halaqa on cellular.
# EXPO_PUBLIC_TURN_URL=
# EXPO_PUBLIC_TURN_USERNAME=
# EXPO_PUBLIC_TURN_CREDENTIAL=
