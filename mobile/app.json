{
  "expo": {
    "name": "مراجعة القرآن",
    "slug": "quran-review",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "runtimeVersion": "appVersion",
    "userInterfaceStyle": "light",
    "newArchitecture": true,
    "scheme": "quran-review",
    "experiments": {
      "baseUrl": "/education-management"
    },
    "updates": {
      "url": "https://u.expo.dev/<EXPO_PROJECT_ID>",
      "enabled": true,
      "channels": ["preview", "production"]
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E20"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quranreview.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSFaceIDUsageDescription": "يستخدم التطبيق Face ID لتسجيل الدخول إلى حسابك بأمان. / The app uses Face ID to securely sign you into your account.",
        "NSMicrophoneUsageDescription": "يحتاج التطبيق إلى الميكروفون لتسجيل التلاوة القرآنية. / The app needs the microphone to record your Quran recitation.",
        "NSDocumentsFolderUsageDescription": "يحتاج التطبيق إلى الوصول للملفات لرفع تسجيلات التلاوة. / The app needs file access to upload recitation recordings.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#1B5E20"
      },
      "package": "com.quranreview.app",
      "usesCleartextTraffic": false,
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC"
      ],
      "blockedPermissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static",
      "bundler": "metro",
      "name": "مراجعة القرآن",
      "shortName": "Quran Review",
      "description": "Quran memorization review and teacher-guided recitation tracking.",
      "themeColor": "#1B5E20",
      "backgroundColor": "#1B5E20",
      "display": "standalone",
      "orientation": "portrait",
      "lang": "ar",
      "dir": "auto"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم التطبيق Face ID لتسجيل الدخول إلى حسابك بأمان."
        }
      ],
      "expo-document-picker",
      [
        "expo-av",
        {
          "microphonePermission": "يحتاج التطبيق إلى الميكروفون لتسجيل التلاوة القرآنية."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B5E20",
          "defaultChannel": "default"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "يحتاج التطبيق إلى الميكروفون لتسجيل التلاوة القرآنية."
        }
      ]
    ]
  }
}
